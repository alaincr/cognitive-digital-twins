{
  "$comment": "Micro-judge output schemas for vLLM guided decoding (guided_json). One schema per judgment type. Confidence is NOT in the schema by design: it is derived from label-token logprobs by the harness (invariant I3). 'basis' is audit-only free text, length-capped, never machine-parsed. additionalProperties:false everywhere = closed output surface.  Includes the Luhmann-Ahrens zettel layer (continues, permanent_worthy).",
  "edge_type": {
    "type": "object",
    "properties": {
      "label": {
        "enum": [
          "supports",
          "opposes",
          "refines",
          "unrelated"
        ]
      },
      "basis": {
        "type": "string",
        "maxLength": 240
      }
    },
    "required": [
      "label"
    ],
    "additionalProperties": false
  },
  "same_entity": {
    "type": "object",
    "properties": {
      "label": {
