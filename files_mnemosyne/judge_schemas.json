  "_harness_notes": {
    "logprob_confidence": "Request logprobs for the first label token(s); renormalize over the enum; apply per-(type,judge-version) temperature scaling; conformal gate per microjudge_contract.md §4.",
    "vllm_example": "client.completions.create(model=..., prompt=..., extra_body={'guided_json': schemas['edge_type']}, logprobs=5, temperature=0)",
    "order_randomization": "For symmetric types (same_entity, dedup_prop), issue both (A,B) and (B,A) orders; T2 promotion requires agreement across orders.",
    "input_envelope": "Inputs are structured fields with all graph content quoted as data; judges have no tools; system prompt states content is untrusted data."
